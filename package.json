{
  "name": "dsh-hongguo",
  "version": "1.1.0-win.1",
  "private": true,
  "type": "module",
  "description": "摸鱼短剧：右侧边栏短剧播放器，入口在左侧栏「全局面板 · 更多」菜单（本地 fork）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./vendor/*": "./vendor/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "cover.ps1",
    "vendor/",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "FORK-NOTES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "bundleDependencies": [
    "openhongguo"
  ],
  "dependencies": {
    "openhongguo": "0.1.0"
  }
}
